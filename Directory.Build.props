<Project>
  <PropertyGroup>
    <ACHomebrewRepositoryRoot>$(MSBuildThisFileDirectory)</ACHomebrewRepositoryRoot>
    <BaseOutputPath>$(ACHomebrewRepositoryRoot)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(ACHomebrewRepositoryRoot)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <!-- Private notes and future code examples are not mod build inputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ACHomebrewRepositoryRoot)notes/**;$(ACHomebrewRepositoryRoot)artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
