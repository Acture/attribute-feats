<Project>
  <PropertyGroup>
    <WotRHomebrewRepositoryRoot>$(MSBuildThisFileDirectory)</WotRHomebrewRepositoryRoot>
    <BaseOutputPath>$(WotRHomebrewRepositoryRoot)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(WotRHomebrewRepositoryRoot)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <!-- Private notes and future code examples are not mod build inputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(WotRHomebrewRepositoryRoot)notes/**;$(WotRHomebrewRepositoryRoot)artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
