<Project Sdk="Microsoft.NET.Sdk">
	<!-- Game-independent rules shared by the mod and its tests. -->
	<PropertyGroup>
		<TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<RootNamespace>ACHomebrew</RootNamespace>
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="AttributeFeats" />
		<InternalsVisibleTo Include="ACHomebrew.Core" />
		<InternalsVisibleTo Include="ACHomebrew.Classic" />
		<InternalsVisibleTo Include="ACHomebrew.Casting" />
		<InternalsVisibleTo Include="ACHomebrew.Playstyle" />
		<InternalsVisibleTo Include="FeatBudget.Tests" />
		<InternalsVisibleTo Include="WeaponDamage.Tests" />
	</ItemGroup>
</Project>
