<Project Sdk="Microsoft.NET.Sdk">
	<!-- Entry assembly: UMM loader, registration order, resources and packaging.
	     Feature projects are merged into WotRHomebrew.dll after build, so the
	     mod still ships as one assembly. -->
	<Import Project="../WrathMod.props" />

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<Version>0.1.2</Version>
		<AssemblyVersion>0.1.2</AssemblyVersion>
		<FileVersion>0.1.2</FileVersion>
		<Authors>AuthorName</Authors>
		<AssemblyName>WotRHomebrew</AssemblyName>
		<!-- UMM Id and install folder stay AttributeFeats so existing installs and settings keep working. -->
		<ModId>AttributeFeats</ModId>
		<DeployToGame Condition="'$(DeployToGame)'==''">true</DeployToGame>
	</PropertyGroup>

	<!-- Helpful diagnostics -->
	<Target Name="PrintPaths" BeforeTargets="CoreCompile">
		<Message Text="WrathInstallDir=$(WrathInstallDir)" Importance="High" />
		<Message Text="UMM=$(WrathInstallDir)\Wrath_Data\Managed\UnityModManager\UnityModManager.dll" Importance="High" />
	</Target>

	<ItemGroup>
		<ProjectReference Include="../WotRHomebrew.Logic/WotRHomebrew.Logic.csproj" />
		<ProjectReference Include="../WotRHomebrew.Core/WotRHomebrew.Core.csproj" />
		<ProjectReference Include="../WotRHomebrew.Attributes/WotRHomebrew.Attributes.csproj" />
		<ProjectReference Include="../WotRHomebrew.Aptitudes/WotRHomebrew.Aptitudes.csproj" />
		<ProjectReference Include="../WotRHomebrew.Martial/WotRHomebrew.Martial.csproj" />
		<ProjectReference Include="../WotRHomebrew.Defense/WotRHomebrew.Defense.csproj" />
		<ProjectReference Include="../WotRHomebrew.Magic/WotRHomebrew.Magic.csproj" />
		<ProjectReference Include="../WotRHomebrew.Summoning/WotRHomebrew.Summoning.csproj" />
		<ProjectReference Include="../WotRHomebrew.Styles/WotRHomebrew.Styles.csproj" />
	</ItemGroup>

	<!-- ModMenu is optional: compile its settings page only when it is installed, never ship it. -->
	<PropertyGroup>
		<ModMenuPath>$(WrathInstallDir)\Mods\ModMenu\ModMenu.dll</ModMenuPath>
		<DefineConstants Condition="Exists('$(ModMenuPath)')">$(DefineConstants);MODMENU</DefineConstants>
	</PropertyGroup>
	<ItemGroup Condition="Exists('$(ModMenuPath)')">
		<Reference Include="$(ModMenuPath)" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ILRepack" Version="2.0.34" PrivateAssets="all" GeneratePathProperty="true" />
		<PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" IncludeAssets="build; contentfiles" Version="0.4.2" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <None Update="Info.json" CopyToOutputDirectory="PreserveNewest" />
	  <None Update="Icons\*.png" CopyToOutputDirectory="PreserveNewest" />
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
	</ItemGroup>

	<!-- Merge the feature assemblies into WotRHomebrew.dll before deploy/zip. -->
	<Target Name="MergeFeatureAssemblies" AfterTargets="Build" BeforeTargets="Deploy">
		<ItemGroup>
			<_MergeInputs Include="$(TargetPath)" />
			<_MergeInputs Include="$(TargetDir)WotRHomebrew.Logic.dll;$(TargetDir)WotRHomebrew.Core.dll;$(TargetDir)WotRHomebrew.Attributes.dll;$(TargetDir)WotRHomebrew.Aptitudes.dll;$(TargetDir)WotRHomebrew.Martial.dll;$(TargetDir)WotRHomebrew.Defense.dll;$(TargetDir)WotRHomebrew.Magic.dll;$(TargetDir)WotRHomebrew.Summoning.dll;$(TargetDir)WotRHomebrew.Styles.dll" />
			<!-- BlueprintCore ships inside the mod so it does not depend on another mod providing it. -->
			<_MergeInputs Include="$(TargetDir)BlueprintCore.dll" />
		</ItemGroup>
		<PropertyGroup>
			<_MergedDir>$(IntermediateOutputPath)merged\</_MergedDir>
		</PropertyGroup>
		<!-- The ILRepack MSBuild task fails under the .NET SDK, so run the tool directly. -->
		<MakeDir Directories="$(_MergedDir)" />
		<Exec Command="&quot;$(PkgILRepack)\tools\ILRepack.exe&quot; /lib:&quot;$(TargetDir.TrimEnd('\'))&quot; /lib:&quot;$(WrathInstallDir)\Wrath_Data\Managed&quot; /lib:&quot;$(WrathInstallDir)\Mods\ModMenu&quot; /out:&quot;$(_MergedDir)$(TargetFileName)&quot; @(_MergeInputs->'&quot;%(FullPath)&quot;', ' ')" />
		<Copy SourceFiles="$(_MergedDir)$(TargetFileName);$(_MergedDir)$(TargetName).pdb" DestinationFolder="$(TargetDir)" />
		<Delete Files="$(TargetDir)WotRHomebrew.Logic.dll;$(TargetDir)WotRHomebrew.Logic.pdb;$(TargetDir)WotRHomebrew.Core.dll;$(TargetDir)WotRHomebrew.Core.pdb;$(TargetDir)WotRHomebrew.Attributes.dll;$(TargetDir)WotRHomebrew.Attributes.pdb;$(TargetDir)WotRHomebrew.Aptitudes.dll;$(TargetDir)WotRHomebrew.Aptitudes.pdb;$(TargetDir)WotRHomebrew.Martial.dll;$(TargetDir)WotRHomebrew.Martial.pdb;$(TargetDir)WotRHomebrew.Defense.dll;$(TargetDir)WotRHomebrew.Defense.pdb;$(TargetDir)WotRHomebrew.Magic.dll;$(TargetDir)WotRHomebrew.Magic.pdb;$(TargetDir)WotRHomebrew.Summoning.dll;$(TargetDir)WotRHomebrew.Summoning.pdb;$(TargetDir)WotRHomebrew.Styles.dll;$(TargetDir)WotRHomebrew.Styles.pdb;$(TargetDir)BlueprintCore.dll" />
	</Target>

	<!-- Deploy to Mods folder + zip -->
	<Target Name="Deploy" AfterTargets="Build" Condition="'$(DeployMod)' != 'false'">
		<ItemGroup>
			<Files Include="$(TargetDir)\**\*.*" />
			<Files Remove="$(TargetDir)\**\*.dll" />
			<Files Remove="$(TargetDir)\**\*.pdb" />
			<Files Remove="$(TargetDir)\**\*.cache" />
			<Files Remove="$(TargetDir)\**\UnityModManager.xml" />
			<Files Include="$(TargetDir)\**\$(AssemblyName).dll" />
			<Files Include="$(TargetDir)\**\$(AssemblyName).pdb" />
			<ToDelete Include="$(TargetDir)\**\*.*" />
			<ToDelete Remove="@(Files)" />
		</ItemGroup>

		<Copy SourceFiles="@(Files)" DestinationFiles="@(Files->'$(WrathInstallDir)\Mods\$(ModId)\%(RecursiveDir)%(Filename)%(Extension)')" Condition="'$(DeployToGame)'=='true'" />
		<Delete Files="@(ToDelete)" />
		<MakeDir Directories="$(WotRHomebrewRepositoryRoot)artifacts/packages" />
		<ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="$(WotRHomebrewRepositoryRoot)artifacts/packages/WotRHomebrew-$(Version).zip" Overwrite="true" />
	</Target>

	<!-- Optional: delete generated props on clean -->
	<Target Name="DeleteCustomPropsFile" BeforeTargets="Clean">
		<Delete Files="$(WotRHomebrewRepositoryRoot)GamePath.props" Condition="Exists('$(WotRHomebrewRepositoryRoot)GamePath.props')" />
	</Target>

</Project>
