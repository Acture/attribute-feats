<Project Sdk="Microsoft.NET.Sdk">
	<!-- Game-independent logic shared by the mod and its tests: budget, exclusion groups, scoring rules and GUIDs. -->
	<PropertyGroup>
		<TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<RootNamespace>ACHomebrew</RootNamespace>
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="AttributeFeats" />
		<InternalsVisibleTo Include="ACHomebrew.Core" />
		<InternalsVisibleTo Include="ACHomebrew.Attributes" />
		<InternalsVisibleTo Include="ACHomebrew.Aptitudes" />
		<InternalsVisibleTo Include="ACHomebrew.Martial" />
		<InternalsVisibleTo Include="ACHomebrew.Defense" />
		<InternalsVisibleTo Include="ACHomebrew.Magic" />
		<InternalsVisibleTo Include="ACHomebrew.Summoning" />
		<InternalsVisibleTo Include="ACHomebrew.Styles" />
		<InternalsVisibleTo Include="FeatBudget.Tests" />
		<InternalsVisibleTo Include="WeaponDamage.Tests" />
	</ItemGroup>
</Project>
