<Project Sdk="Microsoft.NET.Sdk">

  <!-- AttributeFeats mechanics tests on WotR.Testing.Offline (external/wotr-testing): real game assemblies and blueprints, no game process. -->
  <Import Project="$(AttributeFeatsRepositoryRoot)GamePath.props" Condition="Exists('$(AttributeFeatsRepositoryRoot)GamePath.props')" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <WotrModAssembly>$(AttributeFeatsRepositoryRoot)artifacts/bin/AttributeFeats/$(Configuration)/AttributeFeats.dll</WotrModAssembly>
    <WotrSnapshotDirectory>$(AttributeFeatsRepositoryRoot)vendor/wotr</WotrSnapshotDirectory>
    <WotrWorkDirectory>$(AttributeFeatsRepositoryRoot)artifacts/obj/OfflineMechanics.Tests/wotr/</WotrWorkDirectory>
    <WotrReportDirectory>$(AttributeFeatsRepositoryRoot)artifacts/test-results/offline-mechanics/</WotrReportDirectory>
  </PropertyGroup>

  <Import Project="../../external/wotr-testing/src/WotR.Testing.Offline/build/WotR.Testing.Offline.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../external/wotr-testing/src/WotR.Testing.Offline/WotR.Testing.Offline.csproj" AdditionalProperties="WotrInputRoot=$(WotrInputRoot)" />
    <!-- Build the mod from source first, without deploying it, against the same game inputs. -->
    <ProjectReference Include="../../src/AttributeFeats/AttributeFeats.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      AdditionalProperties="DeployMod=false;WrathInstallDir=$(WotrInputRoot)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
